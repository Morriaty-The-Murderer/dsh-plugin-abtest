{
  "name": "dsh-plugin-abtest",
  "version": "0.1.0",
  "description": "Paired experiments and promotion gates for DSH plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Morriaty-The-Murderer/dsh-plugin-abtest.git"
  },
  "homepage": "https://github.com/Morriaty-The-Murderer/dsh-plugin-abtest#readme",
  "bugs": {
    "url": "https://github.com/Morriaty-The-Murderer/dsh-plugin-abtest/issues"
  },
  "keywords": [
    "ab-testing",
    "agent-evaluation",
    "deepseek-harness",
    "dsh-plugin",
    "llm-evaluation",
    "plugin-testing",
    "reproducibility"
  ],
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "dsh-ab": "./lib/cli/bin.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./dsh-plugin": {
      "types": "./lib/dsh-plugin/index.d.ts",
      "default": "./lib/dsh-plugin/index.js"
    },
    "./project.identity.json": "./project.identity.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "project.identity.json",
    "README.md",
    "README.zh-CN.md",
    "assets/social-preview.jpg",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "format": "biome check --write .",
    "identity:sync": "node --import tsx scripts/identity/sync.ts --write",
    "identity:check": "node --import tsx scripts/identity/check.ts",
    "project:rename": "node --import tsx scripts/identity/rename.ts",
    "test:rename": "node --import tsx scripts/identity/test-rename.ts",
    "test:distribution": "node --import tsx scripts/distribution/smoke.ts --json",
    "case-study:summarize": "node --import tsx scripts/case-study/summarize.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "prepack": "tsdown && node --import tsx scripts/identity/check.ts"
  },
  "dependencies": {
    "commander": "15.0.0",
    "tar": "7.4.3",
    "yaml": "2.8.1",
    "zod": "4.1.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh": "0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@types/tar": "6.1.13",
    "@types/node": "22.19.1",
    "tsdown": "0.18.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.14"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
